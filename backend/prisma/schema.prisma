// Prisma schema placeholder for Urban Furniture accounting models.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  contact
}

model User {
  id            Int      @id @default(autoincrement())
  name          String
  login_id      String   @unique
  email         String   @unique
  password_hash String
  role          UserRole
  contact_id    Int?
  contact       Contact? @relation(fields: [contact_id], references: [id])
}

enum ContactType {
  customer
  vendor
  both
}

model Contact {
  id              Int                @id @default(autoincrement())
  name            String
  type            ContactType
  email           String
  mobile          String
  city            String
  state           String
  pincode         String
  image_url       String?
  users           User[]
  documents       Document[]
  journal_entries JournalEntryLine[]
}

enum ProductType {
  goods
  service
  combo
}

model Product {
  id          Int            @id @default(autoincrement())
  name        String
  type        ProductType
  sales_price Decimal
  cost        Decimal
  category    String
  lines       DocumentLine[]
}

enum AccountType {
  asset
  liability
  capital
  income
  expense
}

model ChartOfAccount {
  id            Int                @id @default(autoincrement())
  name          String
  type          AccountType
  journals      Journal[]
  journal_lines JournalEntryLine[]
}

enum JournalType {
  sales
  purchase
  bank
  cash
}

model Journal {
  id                 Int            @id @default(autoincrement())
  name               String
  type               JournalType
  default_account_id Int
  default_account    ChartOfAccount @relation(fields: [default_account_id], references: [id])
  entries            JournalEntry[]
}

enum AnalyticType {
  income
  expense
}

model AnalyticAccount {
  id      Int            @id @default(autoincrement())
  name    String
  type    AnalyticType
  budgets Budget[]
  lines   DocumentLine[]
}

enum BudgetStatus {
  draft
  confirmed
  revised
  cancelled
}

model Budget {
  id                  Int             @id @default(autoincrement())
  name                String
  start_date          DateTime
  end_date            DateTime
  analytic_account_id Int
  analytic_account    AnalyticAccount @relation(fields: [analytic_account_id], references: [id])
  committed_amount    Decimal
  status              BudgetStatus
  revision_of_id      Int?
  revision_of         Budget?         @relation("BudgetRevision", fields: [revision_of_id], references: [id])
  revisions           Budget[]        @relation("BudgetRevision")
}

enum DocType {
  PO
  VENDOR_BILL
  SO
  CUSTOMER_INVOICE
}

enum DocStatus {
  draft
  confirmed
  paid
  cancelled
}

model Document {
  id                 Int            @id @default(autoincrement())
  doc_type           DocType
  number             String         @unique
  contact_id         Int
  contact            Contact        @relation(fields: [contact_id], references: [id])
  source_document_id Int?
  source_document    Document?      @relation("SourceDocument", fields: [source_document_id], references: [id])
  derived_documents  Document[]     @relation("SourceDocument")
  doc_date           DateTime
  due_date           DateTime
  reference          String?
  status             DocStatus
  total              Decimal
  amount_paid        Decimal        @default(0)
  lines              DocumentLine[]
  payments           Payment[]
  journal_entries    JournalEntry[]
}

model DocumentLine {
  id                  Int              @id @default(autoincrement())
  document_id         Int
  document            Document         @relation(fields: [document_id], references: [id])
  product_id          Int
  product             Product          @relation(fields: [product_id], references: [id])
  analytic_account_id Int?
  analytic_account    AnalyticAccount? @relation(fields: [analytic_account_id], references: [id])
  qty                 Decimal
  unit_price          Decimal
  line_total          Decimal
}

enum PaymentDirection {
  send
  receive
}

enum PaymentMethod {
  cash
  bank
}

model Payment {
  id               Int           @id @default(autoincrement())
  document_id      Int
  document         Document      @relation(fields: [document_id], references: [id])
  direction        PaymentDirection
  amount           Decimal
  pay_date         DateTime
  method           PaymentMethod
  note             String?
  journal_entry_id Int?
  journal_entry    JournalEntry? @relation(fields: [journal_entry_id], references: [id])
}

enum JournalEntryStatus {
  draft
  posted
}

model JournalEntry {
  id          Int                @id @default(autoincrement())
  journal_id  Int
  journal     Journal            @relation(fields: [journal_id], references: [id])
  document_id Int?
  document    Document?          @relation(fields: [document_id], references: [id])
  entry_date  DateTime
  reference   String?
  status      JournalEntryStatus
  lines       JournalEntryLine[]
  payments    Payment[]
}

model JournalEntryLine {
  id               Int            @id @default(autoincrement())
  journal_entry_id Int
  journal_entry    JournalEntry   @relation(fields: [journal_entry_id], references: [id])
  account_id       Int
  account          ChartOfAccount @relation(fields: [account_id], references: [id])
  contact_id       Int?
  contact          Contact?       @relation(fields: [contact_id], references: [id])
  debit            Decimal        @default(0)
  credit           Decimal        @default(0)
}
