datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  admin
  contact
}

enum ContactType {
  customer
  vendor
  both
}

enum ProductType {
  goods
  service
  combo
}

enum AccountType {
  asset
  liability
  capital
  income
  expense
}

enum JournalType {
  sales
  purchase
  bank
  cash
}

enum DocType {
  PO
  VENDOR_BILL
  SO
  CUSTOMER_INVOICE
}

enum DocStatus {
  draft
  confirmed
  paid
  partially_paid
  cancelled
}

model User {
  id         Int      @id @default(autoincrement())
  name       String
  login_id   String   @unique
  email      String   @unique
  password   String
  role       Role     @default(admin)
  contact_id Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Contact {
  id        Int         @id @default(autoincrement())
  name      String
  type      ContactType @default(customer)
  email     String?
  mobile    String?
  city      String?
  state     String?
  pincode   String?
  image_url String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Product {
  id          Int         @id @default(autoincrement())
  name        String
  type        ProductType @default(goods)
  sales_price Decimal     @default(0.00) @db.Decimal(12, 2)
  cost        Decimal     @default(0.00) @db.Decimal(12, 2)
  category    String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Account {
  id        Int         @id @default(autoincrement())
  name      String
  type      AccountType
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Journal {
  id                   Int         @id @default(autoincrement())
  name                 String
  type                 JournalType
  default_account_id   Int?
  default_account_name String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
}

model AnalyticAccount {
  id        Int      @id @default(autoincrement())
  name      String
  type      String   @default("expense")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Budget {
  id                    Int       @id @default(autoincrement())
  name                  String
  start_date            String
  end_date              String
  analytic_account_id   Int
  analytic_account_name String?
  type                  String    @default("expense")
  responsible           String?
  committed_amount      Decimal   @default(0.00) @db.Decimal(12, 2)
  status                String    @default("draft")
  revision_of_id        Int?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Document {
  id                     Int       @id @default(autoincrement())
  doc_type               DocType
  number                 String    @unique
  contact_id             Int
  contact_name           String?
  source_document_id     Int?
  source_document_number String?
  doc_date               String
  due_date               String
  reference              String?
  status                 DocStatus @default(draft)
  total                  Decimal   @default(0.00) @db.Decimal(12, 2)
  amount_paid            Decimal   @default(0.00) @db.Decimal(12, 2)
  amount_due             Decimal   @default(0.00) @db.Decimal(12, 2)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

model DocumentLine {
  id                    Int      @id @default(autoincrement())
  document_id           Int
  product_id            Int?
  product_name          String?
  analytic_account_id   Int?
  analytic_account_name String?
  qty                   Decimal  @default(1.00) @db.Decimal(10, 2)
  unit_price            Decimal  @default(0.00) @db.Decimal(12, 2)
  line_total            Decimal  @default(0.00) @db.Decimal(12, 2)
  createdAt             DateTime @default(now())
}

model Payment {
  id               Int      @id @default(autoincrement())
  document_id      Int
  direction        String   @default("send")
  amount           Decimal  @default(0.00) @db.Decimal(12, 2)
  pay_date         String
  method           String   @default("bank")
  note             String?
  journal_entry_id Int?
  createdAt        DateTime @default(now())
}

model JournalEntry {
  id          Int      @id @default(autoincrement())
  journal_id  Int
  journal_name String?
  document_id Int?
  entry_date  String
  reference   String?
  status      String   @default("posted")
  createdAt   DateTime @default(now())
}

model JournalEntryLine {
  id               Int      @id @default(autoincrement())
  journal_entry_id Int
  account_id       Int
  account_name     String?
  contact_id       Int?
  debit            Decimal  @default(0.00) @db.Decimal(12, 2)
  credit           Decimal  @default(0.00) @db.Decimal(12, 2)
}
